##########################   WAHA     ##########################     

# Swagger (OpenAPI) panel at http://<host>:3001/
# Credentials for the Swagger UI only — they do NOT protect the REST API;
# an X-Api-Key header is still required for API access.
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=TOSET

# REST API key: clients must send this value in the X-Api-Key header.
# Format can be the plain key, or sha512:<HASH> (preferred if the .env may leak).
# Also used to authorize media downloads and to log into the dashboard/Swagger.
WAHA_API_KEY=TOSET

# Dashboard admin login at http://<host>:3001/dashboard
WAHA_DASHBOARD_USERNAME=waha
WAHA_DASHBOARD_PASSWORD=TOSET

WHATSAPP_API_PORT=3000
WHATSAPP_PUBLIC_API_PORT=3001
Default engine for sessions. WEBJS is the default; pick NOWEB/GOWS as needed.
WHATSAPP_DEFAULT_ENGINE=WEBJS
Debug/troubleshooting only - keep false for a running service
WAHA_DEBUG_MODE=false
WHATSAPP_HOOK_URL=http://waha-bot:5000/bot
WHATSAPP_HOOK_EVENTS=message
WHATSAPP_HOOK_RETRIES_ATTEMPTS=2
WHATSAPP_HOOK_RETRIES_DELAY_SECONDS=2

# In order for images to be downloaded from the llm
WHATSAPP_API_KEY_EXCLUDE_PATH=api/files/(.*),ping,health

##########################     WAHA-BOT    ##########################     
LLM_API_KEY=TOSET
LLM_URL=http://LLM_URL:PORT/v1
LLM_MODEL=TOSET

WAHA_URL=http://waha:${WHATSAPP_API_PORT}/api/
# Used by the llm to download images from the WAHA API. Must be accessible from the llm.
WAHA_PUBLIC_URL=http://PUBLIC_WAHA_URL:${WHATSAPP_PUBLIC_API_PORT}/api/
NUMBER_OF_THREADS_FOR_WHISPER_MODEL=8

# Set phone numbers allowed to use the bot, separated by commas. Example: 33612345678,33698765432
ALLOWED_USERS=NUMBER1,NUMBER2

#Timezone
TZ=Europe/Paris
